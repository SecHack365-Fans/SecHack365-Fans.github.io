{
  "name": "sechack365_fans",
  "private": true,
  "scripts": {
    "all-format": "prettier --write \"**/*.{ts,tsx,json,md,css}\"",
    "prebuild": "npm run clean",
    "build": "next build --webpack",
    "clean": "rimraf .next",
    "predev": "npm run clean",
    "dev": "next dev --webpack -H 0.0.0.0",
    "format": "prettier --write \"{pages,components,styles,lib}/**/*.{ts,tsx,json,md,css}\"",
    "format:check": "prettier --check \"{pages,components,styles,lib}/**/*.{ts,tsx,json,css}\" \"*.{ts,json,md}\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{css,less,sass,scss}": [
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.5.0",
    "@stylexjs/stylex": "^0.19.1",
    "date-fns": "^4.4.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@stylexjs/eslint-plugin": "^0.19.1",
    "@stylexswc/nextjs-plugin": "^0.19.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "braces": "^3.0.3",
    "micromatch": "^4.0.8",
    "picomatch": "^4.0.7"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
